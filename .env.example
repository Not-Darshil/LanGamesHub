# LanGamesHub configuration. Copy to .env (in the LanGamesHub folder) and fill in values.
# Never commit or share .env. Real environment variables override values in this file.

# --- Database (required) --------------------------------------------------------------
# Must use the postgresql+psycopg:// driver prefix. URL-encode special characters in the
# password (for example @ becomes %40).
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Optional, development only: a separate, disposable database for automated tests.
# Tests create and drop tables there, so never point it at the database above.
# TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME_test

# --- Network --------------------------------------------------------------------------
# 0.0.0.0 accepts connections from other PCs on the LAN.
BIND_HOST=0.0.0.0
BIND_PORT=8000

# --- Guest access (one of these is required) ------------------------------------------
# The shared password guests type to ask the host for access. Prefer the hash form:
# run windows\hash-password.bat and paste its ROOM_PASSWORD_HASH line here.
ROOM_PASSWORD=change-me
# ROOM_PASSWORD_HASH=

# --- Host admin account ---------------------------------------------------------------
# Created on first start if it does not exist yet (8+ characters). Changing these later
# does NOT change an existing admin's password; use windows\set-admin-password.bat.
# You may remove ADMIN_PASSWORD from this file after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# --- Sessions (minutes) ---------------------------------------------------------------
# Approved player sessions expire after this much inactivity.
PLAYER_SESSION_TTL_MINUTES=720
ADMIN_SESSION_TTL_MINUTES=480
# A guest's request waits this long for the host's decision before expiring.
PENDING_REQUEST_TTL_MINUTES=15
# A room member who stays disconnected this long loses their "ready" flag.
DISCONNECT_GRACE_SECONDS=15

# --- Rate limits ----------------------------------------------------------------------
# Per IP address: access requests and admin login attempts per minute.
RATE_LIMIT_ACCESS_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Per player: game actions per second.
RATE_LIMIT_ACTIONS_PER_SECOND=10

# --- Other ----------------------------------------------------------------------------
# CRITICAL, ERROR, WARNING, INFO or DEBUG
LOG_LEVEL=INFO
# Built React assets served to browsers. Relative paths resolve from the LanGamesHub folder.
FRONTEND_DIST_DIR=frontend/dist
# Set to true only if you put LanGamesHub behind HTTPS; plain-HTTP browsers drop Secure cookies.
COOKIE_SECURE=false
